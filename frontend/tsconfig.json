{
  "compilerOptions": {
    "target": "ES2022", "types": ["node"], "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "strict": true, "noImplicitAny": true,
    "module": "ESNext", "moduleResolution": "bundler", "isolatedModules": true,
    "noEmit": true, "allowImportingTsExtensions": true, "jsx": "react-jsx"
  },
  "include": ["src"]
}
