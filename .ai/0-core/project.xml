<?xml version="1.0" encoding="UTF-8"?>
<project_identity priority="0" status="immutable">

    <metadata>
        <name>UserManager03</name>
        <objective>
            Aplicación web de gestión de usuarios con autenticación
            mediante una cuenta operadora independiente.
        </objective>
        <development_approach>API-First</development_approach>
    </metadata>

    <backend>
        <language
            name="Java"
            distribution="Eclipse Temurin"
            version="25.0.5+8"/>
        <framework name="Spring Boot" version="4.1.2"/>
        <build_system name="Apache Maven" version="3.10.0"/>
    </backend>

    <frontend>
        <language name="TypeScript" version="7.0.2"/>
        <framework name="React" version="19.3.1"/>
        <design_system>Material Design</design_system>
        <component_library name="MUI" version="9.5.0"/>
        <runtime name="Node.js" version="24.22.1"/>
        <build_tool name="Vite" version="8.3.5"/>
        <package_manager name="npm" version="11.19.1"/>
    </frontend>

    <api_specification>
        <style>REST</style>
        <representation>JSON</representation>
        <contract_standard>OpenAPI 3.0.3</contract_standard>
    </api_specification>

    <architecture_constraints>
        <pattern priority="critical">
            Arquitectura por capas desacopladas, basada en interfaces
            (Interface-Driven).
        </pattern>

        <layers>
            <layer id="rest">
                Controladores REST que implementan las interfaces
                definidas a partir del contrato OpenAPI.
            </layer>
            <layer id="service">
                Contratos de servicio e implementaciones
                de la lógica de negocio.
            </layer>
            <layer id="persistence">
                Interfaces de repositorio e implementaciones
                de acceso a datos.
            </layer>
        </layers>
    </architecture_constraints>

    <persistence>
        <database name="PostgreSQL" version="18.6"/>
        <access_technology>JPA</access_technology>
        <migration_tool name="Flyway" version="12.4.0"/>
    </persistence>

    <authentication>
        <mechanism>Usuario y contraseña</mechanism>
        <session_model>Sesión mantenida en el servidor</session_model>
        <framework>Spring Security</framework>
    </authentication>

    <containerization>
        <technology>Docker</technology>
        <target_platform>linux/arm64</target_platform>
    </containerization>

</project_identity>
